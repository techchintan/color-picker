{
  "name": "WhatColor - Color Picker & Eyedropper",
  "description": "The fastest color picker and eyedropper tool for all designers. Instantly identify and copy HEX, RGB, and HSL color codes on any webpage.",
  "version": "1.0.0",
  "manifest_version": 3,
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WhatColor",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["storage", "clipboardWrite"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": ["background.js"]
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Open WhatColor"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "color-picker-hex@local",
      "strict_min_version": "109.0"
    }
  }
}
