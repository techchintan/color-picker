{
  "name": "Color Picker HEX | Eyedropper",
  "description": "Pick colors from any webpage or image. Convert HEX, RGB, HSL, and CMYK. Save history and palettes locally.",
  "version": "1.0.0",
  "manifest_version": 3,
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Color Picker",
    "default_icon": "icon.png"
  },
  "permissions": ["storage"],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Open Color Picker"
    }
  }
}
